# Groq API Configuration (via Cloudflare Worker Proxy)
#
# For production security, the API key is stored on Cloudflare Workers
# The browser calls the worker, which securely proxies to Groq
#
# Get your Cloudflare Worker URL after deploying the worker.js
# The worker stores your Groq API key in Cloudflare Secrets

VITE_GROQ_WORKER_URL=https://groq-api-proxy.nakuldeshpande92.workers.dev